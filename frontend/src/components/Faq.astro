---
// FAQ section — left-aligned, matches container width used by other sections.
// Uses the native `name` attribute on <details> so only one item stays open
// at a time (modern browser feature, no JS needed).
// Titles are manually split into two lines to match the reference layout.

interface FaqItem {
  id: string;
  titleLines: [string, string];
  content: string;
}

const items: FaqItem[] = [
  {
    id: '1',
    titleLines: ['What Services Does Mohammed', 'Ashiq Offer?'],
    content:
      "Mohammed Ashiq offers a wide range of services including search engine optimization, social media marketing, website development, content marketing, SEO copywriting, and search engine marketing. This Freelance Digital Marketer in Kerala's comprehensive skill set ensures that your online presence is optimized for success in Malappuram.",
  },
  {
    id: '2',
    titleLines: ['Does He Work Outside', 'Malappuram And Kerala?'],
    content:
      "Yes, Mohammed Ashiq's digital marketing services are not confined to Malappuram or Kerala. His reputation as a skilled strategist has earned him clients from all over India and beyond. Whether you're a local business or an international brand, his solutions are designed to deliver measurable results.",
  },
  {
    id: '3',
    titleLines: ['How Can His SEO Expertise', 'Benefit My Business?'],
    content:
      'With a strong focus on improving search engine rankings, Mohammed Ashiq crafts SEO strategies that drive organic traffic and enhance online visibility. His methods are designed to help businesses stand out in competitive markets, making it easier for potential customers to find you.',
  },
  {
    id: '4',
    titleLines: ['Can He Integrate Web', 'Development With SEO?'],
    content:
      'Absolutely. Mohammed Ashiq ensures that every website he develops aligns with modern SEO practices. This integration creates a seamless experience for both users and search engines, resulting in a site that performs well and captures attention.',
  },
];
---

<section class="relative bg-black text-white overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-20 md:py-28">

    <!-- header -->
    <div class="mb-14 md:mb-20">
      <p class="text-xs tracking-[0.3em] uppercase text-white/50 mb-4">FAQ</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight uppercase leading-[1.05]">
        Common Questions
      </h2>
    </div>

    <div class="w-full">
      {items.map((item) => (
        <details name="faq-group" class="faq-item border-b border-white/15">
          <summary class="faq-summary flex items-start gap-4 cursor-pointer list-none">
            <span class="faq-number text-xs shrink-0">{item.id}</span>
            <h3 class="faq-title uppercase text-3xl md:text-5xl font-bold text-left leading-tight">
              {item.titleLines[0]}<br />{item.titleLines[1]}
            </h3>
          </summary>
          <div class="faq-content pl-9 md:pl-14">
            <p class="text-white/50 text-sm md:text-base leading-relaxed max-w-2xl pb-6">
              {item.content}
            </p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* closed: tightly compressed, text nearly overlapping the border line */
  .faq-summary {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: -0.15em;
    transition: margin 0.3s ease, padding 0.3s ease;
  }

  .faq-title {
    color: rgba(255, 255, 255, 0.15);
    transition: color 0.3s ease;
  }
  .faq-number {
    color: rgba(255, 255, 255, 0.3);
    margin-top: 0.6em;
    transition: color 0.3s ease;
  }

  /* open: expands to normal spacing, text turns bright */
  details[open] .faq-summary {
    margin-top: 0;
    padding-top: 1.5rem;
    padding-bottom: 0.5rem;
  }
  details[open] .faq-title {
    color: rgba(255, 255, 255, 1);
  }
  details[open] .faq-number {
    color: rgba(255, 255, 255, 0.6);
  }

  .faq-item:not([open]) summary:hover .faq-title {
    color: rgba(255, 255, 255, 0.35);
  }

  @media (min-width: 768px) {
    .faq-summary {
      margin-top: -0.25em;
    }
    details[open] .faq-summary {
      padding-top: 2rem;
      padding-bottom: 0.75rem;
    }
  }
</style>