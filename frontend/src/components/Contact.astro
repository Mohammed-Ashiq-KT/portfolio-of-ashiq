---

<section id="contact" class="relative scroll-mt-20 bg-black text-white overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-20 md:py-28">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-8">
      <!-- left: intro -->
      <div class="flex flex-col">
        <div>
          <p class="text-xs tracking-[0.3em] uppercase text-white/50 mb-4">Get In Touch</p>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight uppercase leading-[1.05] mb-6">
            Let's Connect
          </h2>
          <p class="text-white/50 text-sm md:text-base leading-relaxed max-w-md">
            Have a project in mind or just want to talk strategy? Send a message and I'll get back to you within a day or two.
          </p>
        </div>

        <div class="mt-10 space-y-6">
          <a href={`mailto:${email}`} class="flex items-center gap-4 group w-fit">
            <span class="flex h-11 w-11 items-center justify-center border border-white/20 shrink-0 transition-colors group-hover:bg-white group-hover:text-black">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg>
            </span>
            <span class="text-sm md:text-base text-white/80 group-hover:text-white">{email}</span>
          </a>
          <a href={`tel:${phone.replace(/\s/g, '')}`} class="flex items-center gap-4 group w-fit">
            <span class="flex h-11 w-11 items-center justify-center border border-white/20 shrink-0 transition-colors group-hover:bg-white group-hover:text-black">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 2.9a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.5 2.9.6a2 2 0 0 1 1.8 2.1Z"/></svg>
            </span>
            <span class="text-sm md:text-base text-white/80 group-hover:text-white">{phone}</span>
          </a>

          <div class="flex items-center gap-3 pt-2">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="flex h-11 w-11 items-center justify-center border border-white/20 text-white/70 transition-colors hover:bg-white hover:text-black"
                set:html={s.icon}
              />
            ))}
          </div>
        </div>
      </div>

      <!-- right: form -->
      <div>
        <form id="contact-form" class="flex flex-col gap-6">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />

          <div>
            <label for="cf-name" class="block text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Name</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              class="w-full bg-black border border-white/20 px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white transition-colors"
              placeholder="Your full name"
            />
          </div>

          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="cf-phone" class="block text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Number</label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                class="w-full bg-black border border-white/20 px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white transition-colors"
                placeholder="+91 00000 00000"
              />
            </div>
            <div>
              <label for="cf-email" class="block text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Email</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                required
                class="w-full bg-black border border-white/20 px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white transition-colors"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <label for="cf-message" class="block text-xs tracking-[0.2em] uppercase text-white/50 mb-2">Message</label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              class="w-full bg-black border border-white/20 px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white transition-colors resize-none"
              placeholder="Tell me a bit about your project..."
            ></textarea>
          </div>

          <button
            id="cf-submit"
            type="submit"
            class="mt-2 w-full sm:w-fit px-8 py-4 border border-white/20 bg-black text-white text-sm tracking-[0.15em] uppercase transition-colors hover:bg-white hover:text-black disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Send Message
          </button>

          <p id="cf-status" class="text-sm min-h-[1.25rem]"></p>
        </form>
      </div>
    </div>

    <!-- footer strip — this section doubles as the site footer -->
    <div class="mt-20 md:mt-28 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/40">
      <p>© {new Date().getFullYear()} Mohammed Ashiq KT. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-white transition-colors">Home</a>
        <a href="#contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('cf-submit');
  const status = document.getElementById('cf-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    submitBtn?.setAttribute('disabled', 'true');
    if (status) {
      status.textContent = 'Sending...';
      status.style.color = 'rgba(255,255,255,0.5)';
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (result.success) {
        if (status) {
          status.textContent = "Message sent — I'll get back to you soon.";
          status.style.color = '#e5e5e5';
        }
        form.reset();
      } else {
        if (status) {
          status.textContent = result.message || 'Something went wrong. Please try again.';
          status.style.color = '#ff6b6b';
        }
      }
    } catch (err) {
      if (status) {
        status.textContent = 'Network error — please try again.';
        status.style.color = '#ff6b6b';
      }
    } finally {
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>