---
const tags = ['Strategy', 'Content', 'Performance'];
---

<section id="profile" class="relative bg-[#0A0A0A] text-white overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-16 md:py-28 grid md:grid-cols-2 gap-8 md:gap-16 items-center">

    <!-- IMAGE: mobile = middle, desktop = left column -->
    <div class="relative profile-img-in order-2 md:order-1">
      <div class="relative aspect-[4/5] md:aspect-[3/4] max-w-md mx-auto md:mx-0 overflow-hidden">
        <img
          src="/profile-img.jpg"
          alt="Mohammed Ashiq KT"
          class="w-full h-full object-cover object-top"
        />
        <!-- fade into background on the right + bottom -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-[#0A0A0A]/80 pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>

    <!-- RIGHT COLUMN wrapper:
         mobile  -> display: contents (children become separate grid items, so they can go above/below the image)
         desktop -> normal block in the right column -->
    <div class="contents md:block md:order-2">

      <!-- HEADING PART: first on mobile (above the image) -->
      <div class="profile-text-in order-1 md:order-none">
        <p class="text-xs tracking-[0.3em] uppercase text-white/50 mb-4">About Me</p>

        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.05] mb-6">
          MOHAMMED<br />ASHIQ&nbsp;KT
        </h2>

                <div class="flex flex-nowrap md:flex-wrap gap-2 md:gap-3 mb-0 md:mb-6">
          {tags.map((tag) => (
            <span class="whitespace-nowrap text-[10px] sm:text-xs uppercase tracking-wider md:tracking-widest border border-white/25 rounded-full px-3 py-1.5 md:px-4 md:py-2 text-white/70">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- DESCRIPTION + BUTTONS PART: last on mobile (below the image) -->
      <div class="profile-text-in order-3 md:order-none">
        <p class="text-white/60 max-w-md mb-8 text-sm md:text-base leading-relaxed">
          I'm Mohammed Ashiq — a Google-certified digital marketer and multimedia creator based in Kerala.
          I help businesses grow their online presence end-to-end: from strategy and SEO to content
          production, social media management, and data-driven ad campaigns. Whether it's shooting and
          editing a product video, running a Meta ads campaign, or turning raw data into a clear
          performance report, I bring both the creative and analytical sides of marketing together to
          drive real results.
        </p>

        <div class="flex items-center gap-6">
          <a href="#contact" class="bg-white text-black text-xs tracking-widest uppercase px-8 py-3 hover:bg-white/85 transition-colors">
            Let's Talk
          </a>
          <a href="#work" class="flex items-center gap-3 text-xs tracking-widest uppercase text-white/80 hover:text-white transition-colors">
            <span class="w-9 h-9 rounded-full border border-white/40 flex items-center justify-center">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="white">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
            View Work
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
<style>
  @keyframes fadeSlideUp {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes fadeScaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .profile-text-in {
    animation: fadeSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .profile-img-in {
    animation: fadeScaleIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .profile-text-in, .profile-img-in {
      animation: none;
    }
  }
</style>