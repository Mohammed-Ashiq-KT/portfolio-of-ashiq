---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header
  class:list={["relative z-40 text-black", transparent ? "absolute inset-x-0 top-0 bg-transparent" : ""]}
  style={transparent ? undefined : "background: #f5f5f3;"}
>
  <nav class="flex items-center justify-between gap-6 px-6 md:px-12 py-6 max-w-[1600px] mx-auto">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo.png" alt="Ashi logo" class="h-12 w-auto" />
    </a>

    <ul class="hidden md:flex items-center gap-10 text-xs tracking-widest uppercase font-medium text-black">
      <li><a href="/" class="hover:opacity-60 transition-opacity">Home</a></li>
      <li><a href="#profile" class="hover:opacity-60 transition-opacity">Profile</a></li>
      <li><a href="#services" class="hover:opacity-60 transition-opacity">Services</a></li>
      <li><a href="#contact" class="hover:opacity-60 transition-opacity">Connect</a></li>
    </ul>

    <div class="hidden lg:flex items-center bg-white border border-black/10 rounded-full pl-5 pr-2 py-2 w-64 shrink-0">
      <input
        type="text"
        placeholder="I'm looking for..."
        class="bg-transparent text-xs placeholder:text-black/40 focus:outline-none w-full"
      />
      <button aria-label="Search" class="w-7 h-7 rounded-full bg-black/5 flex items-center justify-center shrink-0">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
    </div>

    <a
      href="#contact"
      class="lg:hidden inline-block bg-black text-white text-xs tracking-widest uppercase px-6 py-3 hover:bg-black/80 transition-colors shrink-0"
    >
      Connect Me
    </a>
  </nav>
</header>